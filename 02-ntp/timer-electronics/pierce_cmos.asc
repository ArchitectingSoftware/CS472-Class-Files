TEXT 120 -32 Left 3 ;PIERCE CRYSTAL OSCILLATOR  -  32.768 kHz
TEXT 384 24 Left 2 ;FEEDBACK
TEXT 416 216 Left 2 ;AMPLIFIER
TEXT 984 232 Left 2 ;OUTPUT BUFFER
TEXT 320 576 Left 2 ;RESONATOR (the crystal)
TEXT -256 912 Left 2 ;RESONATOR - the crystal, emulated as a series LRC
TEXT -256 936 Left 2 ;At one frequency Lm and Cm cancel and the branch is just Rm = 30k.
TEXT -256 960 Left 2 ;Everywhere else it is nearly an open circuit. That selectivity is
TEXT -256 984 Left 2 ;the entire reason a crystal works.
TEXT -256 1016 Left 2 ;C0 is the plate capacitance. It must stay well under CL1/CL2 or it
TEXT -256 1040 Left 2 ;shunts the motional branch and the oscillator will not start.
TEXT -256 1064 Left 2 ;Stray board capacitance does exactly this to real designs.
TEXT 624 904 Left 2 ;FEEDBACK - R1 carries no DC current, so it forces Vin = Vout and
TEXT 624 928 Left 2 ;parks the inverter at VS/2, in its LINEAR region. It amplifies
TEXT 624 952 Left 2 ;instead of switching. That is the whole trick.
TEXT 624 984 Left 2 ;THE LOOP: xin -> inverter (180 deg) -> xout -> R2 -> crystal
TEXT 624 1008 Left 2 ;with CL1/CL2 (180 deg) -> back to xin. 360 degrees total and
TEXT 624 1032 Left 2 ;gain above 1, so it sustains. R2 limits drive into the crystal.
TEXT 624 1056 Left 2 ;CL1/CL2 are not decoupling caps - with the crystal they form the
TEXT 624 1080 Left 2 ;pi network that supplies the second 180 deg and set the frequency.
TEXT -104 1232 Left 2 !.param VS=3.3
TEXT -104 1256 Left 2 !Vsup vdd 0 {VS}
TEXT -104 1280 Left 2 !.model MN NMOS(VTO=0.7  KP=100u LAMBDA=0.02)
TEXT -104 1304 Left 2 !.model MP PMOS(VTO=-0.7 KP=50u  LAMBDA=0.02)
TEXT -104 1328 Left 2 !Ikick 0 xin PULSE(0 1u 100u 100n 100n 1u)
TEXT 632 1224 Left 2 !.ic V(xin)={VS/2} V(n1)={VS/2} V(n2)={VS/2} V(x2)={VS/2} V(xout)={VS/2}
TEXT 632 1248 Left 2 !.tran 0 8m 0 0.2u uic
TEXT 632 1272 Left 2 !.options plotwinsize=0
TEXT 632 1296 Left 2 !.meas TRAN t1   WHEN V(xin)={VS/2} RISE=1  TD=6m
TEXT 632 1320 Left 2 !.meas TRAN t2   WHEN V(xin)={VS/2} RISE=51 TD=6m
TEXT 632 1344 Left 2 !.meas TRAN fosc PARAM 50/(t2-t1)
